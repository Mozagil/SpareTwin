# Canlı ortam ayarları. Bu dosyanın kopyası (.env) asla repoya girmez.
API_DOMAIN=api.sparetwin.example.com
DEPLOYMENT_MODE=cloud

POSTGRES_ADMIN_PASSWORD=degistir-uzun-rastgele
APP_DB_USER=sparetwin
APP_DB_PASSWORD=degistir-uzun-rastgele
APP_DB_NAME=sparetwin

# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=degistir

# WeWeb'de yayınlanan uygulamanın adresi (ve gerekirse editör önizleme adresi)
CORS_ORIGINS=https://app.sparetwin.example.com

# Dosyalar: local (sunucu diski, yedeğe dahil) veya s3 (S3 uyumlu nesne deposu)
STORAGE_BACKEND=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_REGION=eu-central-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
