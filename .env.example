# Geliştirme ayarları. Kopyala: cp .env.example .env
ENV=dev
DEPLOYMENT_MODE=cloud
DATABASE_URL=postgresql://sparetwin:sparetwin@localhost:5432/sparetwin
TEST_DATABASE_URL=postgresql://sparetwin:sparetwin@localhost:5432/sparetwin_test

# Üret: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Canlıda mutlaka farklı ve gizli bir değer kullan.
JWT_SECRET=gelistirme-icin-gecici-anahtar-canlida-kullanma-0123456789

# WeWeb editörü ve yayınlanan uygulamanın adresleri, virgülle.
# Geliştirmede "*" kabul edilir; canlıda tek tek yaz.
CORS_ORIGINS=*

STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./.media
# Codespace'te 8000 portunun dışarıya açık adresi (Ports sekmesinden kopyala)
PUBLIC_BASE_URL=http://localhost:8000
